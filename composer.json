{
    "name": "internetguru/laravel-scripts",
    "description": "Composer scripts for Laravel. Automatically available.",
    "type": "composer-plugin",
    "autoload": {
        "psr-4": {
            "InternetGuru\\LaravelScripts\\": "src/"
        }
    },
    "authors": [
        {
            "name": "petrzpav",
            "email": "pavel.petrzela@internetguru.cz"
        }
    ],
    "require": {
        "composer-plugin-api": "^2.0"
    },
    "extra": {
        "class": "InternetGuru\\LaravelScripts\\ComposerPlugin"
    },
    "require-dev": {
        "composer/composer": "^2",
        "phpstan/phpstan": "^2"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    }
}
